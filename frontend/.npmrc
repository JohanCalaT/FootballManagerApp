# npm 9+ enforces peer dependency resolution strictly. Two of our deps
# trip that:
#   - @angular/fire declares firebase-tools@^14 as peerOptional; we use
#     firebase-tools@^15 for the Auth Emulator (newer features).
#   - @angular/fire also pulls @angular/platform-browser-dynamic with a
#     pinned-patch peer requirement (20.3.21) while the rest of the
#     project resolves Angular at 20.3.19.
# Both conflicts are cosmetic — peerOptional is intentionally lenient,
# and a patch-version Angular drift inside the same minor is safe.
# Setting this flag here makes `npm ci` (CI) and `npm install` (local)
# behave the same without having to remember the CLI flag.
legacy-peer-deps=true
